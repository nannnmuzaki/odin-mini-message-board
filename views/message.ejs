<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <div class="root">
      <%- include("partials/header") %>
      <main>
        <div class="message-individual">
          <strong class="msg-author"><%= message.user %></strong>
          <p class="msg-text"><%= message.text %></p>
          <p class="msg-date"><%= message.added.toDateString() %></p>
        </div>
      </main>
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
