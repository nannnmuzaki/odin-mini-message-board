<form class="msg-form" method="POST"
  action="/messages<%= formType === "edit" && message?.id
  ? "/" + message.id + "/update"
  : "/new" %>">
  <div class="input-wrapper">
    <label for="user">Name</label>
    <input type="text" name="user" id="user" placeholder="Enter your name"
      value="<%= message?.user && message.username %>" required>
  </div>
  <div class="input-wrapper">
    <label for="text">Text</label>
    <textarea name="text" id="text" placeholder="Enter your text" required><%= message?.text && message.text %></textarea>
  </div>
  <div class="form-btn">
    <button type="reset">Reset</button>
    <button type="submit"><%= formType === "edit" ? "Update" : "Create" %></button>
  </div>
</form>
