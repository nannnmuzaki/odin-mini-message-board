<form class="msg-form" method="POST"
  action="/message/<%= formType === "update"
  ? "edit/" + message.id
  : "new" %>">
  <div class="input-wrapper">
    <label for="user">Name</label>
    <input type="text" name="user" id="user" placeholder="Enter your name"
      value="<%= message?.user && message.user %>">
  </div>
  <div class="input-wrapper">
    <label for="text">Text</label>
    <textarea name="text" id="text" placeholder="Enter your text">
      <%= message?.text && message.text %>
    </textarea>
  </div>
  <div class="form-btn">
    <button type="reset">Reset</button>
    <button type="submit"><%= formType === "update" ? "Update" : "Create" %></button>
  </div>
</form>
