<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Odin Message Board</title>
  </head>
  <body>
    <div class="root">
      <%- include("partials/header") %>
      <main>
        <h1>Message Board</h1>
        <div class="messages">
          <% messages && messages.forEach((message) => { %>
              <a class="msg-item" href="messages/<%= message.id %>">
                <strong class="msg-author"><%= message.username %></strong>
                <p class="msg-text"><%= (message.text.length > 200
                  ? message.text.slice(0, 200) + "..."
                  : message.text)  %></p>
                <p class="msg-date">Created at: <%= new Date(message.created_at).toLocaleString(); %></p>
                <p class="msg-date">
                  Updated at: <%= message.updated_at
                  ? new Date(message.created_at).toLocaleString()
                  : "-"; %>
                </p>
              </a>
            <% }); %>
            <% if (!messages || !(messages.length > 0)) { %>
              <p>There's no messages on this board yet! start writing!</p>
            <% } %>
        </div>
      </main>
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
