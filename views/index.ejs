<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <div class="root">
      <%- include("partials/header") %>
      <main>
        <h1>Message Board</h1>
        <div class="messages">
          <% messages && messages.forEach((message) => { %>
              <a class="msg-item" href="message/<%= message.id %>">
                <strong class="msg-author"><%= message.user %></strong>
                <p class="msg-text"><%= (message.text.length > 200
                  ? message.text.slice(0, 200) + "..."
                  : message.text)  %></p>
                <p class="msg-date"><%= new Date(message.added).toLocaleString(); %></p>
              </a>
            <% }); %>
            <% if (!messages) { %>
              <p>There's no messages on this board yet! start writing!</p>
            <% } %>
        </div>
      </main>
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
